table fact_payment_method_daily
	lineageTag: 1136d7db-0656-597c-b60f-c7965fe13a9f

	measure 'Method Captures SAR' = SUM(fact_payment_method_daily[gross_captures_sar])
		formatString: #,0.00
		lineageTag: 1fe5a32e-efa7-525c-84ea-3e5e3207afb8

	measure 'Method Bank Fees SAR' = SUM(fact_payment_method_daily[acquirer_fees_sar])
		formatString: #,0.00
		lineageTag: ae490985-b35c-5961-9156-f128e1c2a87d

	measure 'Method Fee Rate bps' = DIVIDE(SUM(fact_payment_method_daily[acquirer_fees_sar]), SUM(fact_payment_method_daily[gross_captures_sar])) * 10000
		formatString: 0.0
		lineageTag: a0a5ea42-e181-5a44-88fe-0f14f29aa161

