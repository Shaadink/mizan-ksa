table fact_merchant_settlement_recon
	lineageTag: a936d443-6ea9-59c9-bb6e-d2f1ff7414b1

	measure 'Gross Captures SAR' = SUM(fact_merchant_settlement_recon[gross_captures_sar])
		formatString: #,0.00
		lineageTag: 71ef3696-49e6-5361-9704-ca8b2f490566

	measure 'Refunds and Disputes SAR' = SUM(fact_merchant_settlement_recon[refunds_and_disputes_sar])
		formatString: #,0.00
