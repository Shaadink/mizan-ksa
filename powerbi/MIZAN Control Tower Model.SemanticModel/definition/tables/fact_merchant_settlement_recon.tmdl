	measure 'Bank Paid SAR' = SUM(fact_merchant_settlement_recon[bank_paid_sar])
		formatString: #,0.00
		lineageTag: 9ba4e20c-1425-52de-bdb1-3f4553677604

	measure 'In Transit SAR' = SUM(fact_merchant_settlement_recon[in_transit_sar])
		formatString: #,0.00
