table fact_merchant_dispute_monitor
	lineageTag: f13d2851-8da8-5d71-9a86-2897be7b6b26

	measure 'Merchants Flagged By Ratio Only' = CALCULATE(COUNTROWS(fact_merchant_dispute_monitor), KEEPFILTERS(fact_merchant_dispute_monitor[breaches_ratio] = TRUE()))+ 0
		formatString: #,0
		lineageTag: 8e567bda-4b30-56d6-9d10-fe51f719956b

	measure 'Merchants In Monitoring Programme' = CALCULATE(COUNTROWS(fact_merchant_dispute_monitor), KEEPFILTERS(fact_merchant_dispute_monitor[in_monitoring_programme] = TRUE()))+ 0
		formatString: #,0
		lineageTag: 7af2bb40-890d-5866-ad10-914afaf08331

	measure 'Merchants Monitored' = COUNTROWS(fact_merchant_dispute_monitor) + 0
		formatString: #,0
		lineageTag: 07a3a890-c7b6-51bb-ae54-541dc08ffc34

	measure 'Disputes' = SUM(fact_merchant_dispute_monitor[dispute_count]) + 0
		formatString: #,0
		lineageTag: 5096098a-0029-535c-87dc-454823ba3973

	measure 'Captures' = SUM(fact_merchant_dispute_monitor[capture_count]) + 0
		formatString: #,0
		lineageTag: 0136c8a6-34a5-5707-9fe8-001a9d9c5032

	measure 'Dispute Ratio Pct' = DIVIDE(SUM(fact_merchant_dispute_monitor[dispute_count]), SUM(fact_merchant_dispute_monitor[capture_count])) * 100
		formatString: 0.00"%"
		lineageTag: 759a893d-99b2-5cfa-917e-a1496266365c

	measure 'Disputed SAR' = SUM(fact_merchant_dispute_monitor[disputes_sar])
		formatString: #,0.00
		lineageTag: 2b9eb6bf-935f-5332-8b08-d98907cde975

	measure 'Portfolio Dispute Ratio Pct' = DIVIDE(SUM(fact_merchant_dispute_monitor[dispute_count]), SUM(fact_merchant_dispute_monitor[capture_count])) * 100
		formatString: 0.00"%"
		lineageTag: d67ac1c5-b1dd-54c7-85ed-a20ea38567b6

