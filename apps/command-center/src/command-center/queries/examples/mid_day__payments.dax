// Payment-method cards: captures, the bank's fees (MDR + VAT from the settlement file) and captures per day.
// Long form (kind, key, n, captures_h, fees_h, est_h); money in integer halalas.
EVALUATE
CALCULATETABLE(
UNION(
    SELECTCOLUMNS(
        GROUPBY(fact_payment_method_daily, fact_payment_method_daily[payment_method],
            "c", SUMX(CURRENTGROUP(), fact_payment_method_daily[capture_count]),
            "g", SUMX(CURRENTGROUP(), fact_payment_method_daily[gross_captures_sar]),
            "f", SUMX(CURRENTGROUP(), fact_payment_method_daily[acquirer_fees_sar]),
            "e", SUMX(CURRENTGROUP(), fact_payment_method_daily[fees_estimated_sar])),
        "kind", "METHOD", "key", fact_payment_method_daily[payment_method], "n", [c],
        "captures_h", CONVERT(ROUND([g] * 100, 0), INTEGER), "fees_h", CONVERT(ROUND([f] * 100, 0), INTEGER),
        "est_h", CONVERT(ROUND([e] * 100, 0), INTEGER)),
    SELECTCOLUMNS(
        GROUPBY(fact_payment_method_daily, fact_payment_method_daily[payment_method], fact_payment_method_daily[business_date_ksa],
            "g", SUMX(CURRENTGROUP(), fact_payment_method_daily[gross_captures_sar])),
        "kind", "METHODDAY", "key", fact_payment_method_daily[payment_method] & "|" & FORMAT(fact_payment_method_daily[business_date_ksa], "yyyy-mm-dd"),
        "n", 0, "captures_h", CONVERT(ROUND([g] * 100, 0), INTEGER), "fees_h", 0, "est_h", 0)
),
    fact_payment_method_daily[business_date_ksa] >= DATE(2026, 2, 21),
    fact_payment_method_daily[business_date_ksa] <= DATE(2026, 2, 21),
    fact_payment_method_daily[merchant_id] = "MID900001"
)